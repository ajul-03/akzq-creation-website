# Next.js Environment Variables Template
NEXT_PUBLIC_SITE_URL=https://akzqcreation.com
NEXT_PUBLIC_WHATSAPP_PHONE=917510109730

# Optional extra origins allowed to post to /api/leads (comma-separated, e.g. https://preview.example.com)
ALLOWED_ORIGINS=""

# Database Connection Strings (Neon Postgres)
# Pooled runtime connection (used by Prisma Client in production/development)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require"

# Direct unpooled connection (MUST be used for Prisma migrations and schema operations)
DIRECT_URL="postgresql://user:password@ep-sample.region.neon.tech/neondb?sslmode=require"

# Secret for hashing IP addresses with HMAC-SHA256 (generate with: openssl rand -hex 32)
IP_HASH_SECRET=""

# Optional Email Notifications via Resend (default: disabled if unset)
RESEND_API_KEY=""
NOTIFY_EMAIL="you@example.com"
RESEND_FROM_EMAIL="leads@example.com"
# Optional custom Resend API base URL (useful for testing with mock servers or proxying)
RESEND_BASE_URL="https://api.resend.com"
